import { Button, ComboBox, Slider } from "std-widgets.slint";
import { DialogCard } from "dialog.slint";
import { AppPalette } from "palette.slint";
import { VScrollArea } from "scrolling.slint";
import { ComposerRow } from "types.slint";
import { TipContent } from "tooltip.slint";

// One labelled 0..1 slider (100 steps) with its value read out beside it. The
// slider starts at `initial`, then owns its value and reports every change.
component GainSlider inherits HorizontalLayout {
    in property <string> label;
    in property <color> tint: AppPalette.body;
    in property <float> initial;
    callback changed(float);

    spacing: 8px;
    height: 22px;
    Text {
        text: root.label;
        color: root.tint;
        font-weight: 700;
        width: 12px;
        vertical-alignment: center;
    }
    slider := Slider {
        horizontal-stretch: 1;
        minimum: 0.0;
        maximum: 1.0;
        step: 0.01;
        init => {
            self.value = root.initial;
        }
        changed(value) => {
            root.changed(value);
        }
    }
    Text {
        text: round(slider.value * 100) / 100;
        color: AppPalette.muted;
        width: 30px;
        vertical-alignment: center;
    }
}

// One piece of an image name on a slot's handle.
component NamePart inherits Text {
    color: AppPalette.title;
    vertical-alignment: center;
}

// One input slot: its image name over the four sliders that say how much the
// image feeds the output red, green and blue and the luminance channel.
component ComposerSlot inherits Rectangle {
    in property <ComposerRow> slot;
    callback gain-changed(int, float);

    background: AppPalette.panel-bg;
    border-radius: 6px;
    border-width: 2px;
    border-color: AppPalette.panel-border;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        Rectangle {
            height: 24px;
            clip: true;
            background: AppPalette.header-bg;
            border-radius: 4px;
            // The name's start and end are fixed and its middle takes
            // whatever room is left, elided only when it doesn't fit.
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 0px;
                NamePart {
                    text: root.slot.name-head;
                }
                NamePart {
                    text: root.slot.name-mid;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                NamePart {
                    text: root.slot.name-tail;
                }
            }
            // Hovering the name shows the image's full file name, which the
            // slot itself may have had to elide.
            TouchArea {
                Tooltip {
                    TipContent {
                        text: root.slot.full-name;
                    }
                }
            }
        }

        GainSlider {
            label: "R";
            tint: #e06060;
            initial: root.slot.red;
            changed(value) => {
                root.gain-changed(0, value);
            }
        }
        GainSlider {
            label: "G";
            tint: #50b050;
            initial: root.slot.green;
            changed(value) => {
                root.gain-changed(1, value);
            }
        }
        GainSlider {
            label: "B";
            tint: #6090e0;
            initial: root.slot.blue;
            changed(value) => {
                root.gain-changed(2, value);
            }
        }
        GainSlider {
            label: "L";
            initial: root.slot.lum;
            changed(value) => {
                root.gain-changed(3, value);
            }
        }
    }
}

// The Tools ▸ RGB Compositor… modal: the checked images on the left, each with
// sliders for how much it feeds red, green, blue and luminance, and a live
// preview of the composition on the right, with a draggable splitter between
// the two. One global slider blends the lightness of the colour result towards
// the composed luminance channel; hover an image's name for its full file
// name. Save… writes the composition at full size and closes the dialog.
// Purely presentational: Rust loads the images, holds the slider values and
// renders `preview`.
export component ComposerDialog inherits DialogCard {
    in property <[ComposerRow]> rows;
    in property <image> preview;
    // Shown over the preview while it loads, or instead of it on failure.
    in property <string> notice;
    // A save from an earlier opening is still running.
    in property <bool> saving;
    // The file type Save… asks for: 0 = .fits, 1 = .fit, 2 = .tiff.
    in-out property <int> save-format;
    callback gain-changed(int, int, float);
    callback luminance-changed(float);
    callback save();
    callback close();

    resizable: true;
    min-card-width: 640px;
    min-card-height: 420px;

    // Every slot is the same height, so slots sit at fixed offsets in the
    // scrolling list.
    property <length> slot-height: 150px;
    property <length> slot-gap: 8px;
    // Width of the sources pane, set by dragging the splitter; the split clamps
    // it to what fits.
    property <length> sources-width: 280px;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        Text {
            text: "RGB Compositor";
            font-size: 20px;
            font-weight: 700;
            color: AppPalette.title;
        }

        split := Rectangle {
            vertical-stretch: 1;
            // The grab strip between the panes, and the narrowest either pane
            // may be dragged to. The sources pane is clamped on use, so
            // shrinking the dialog squeezes it rather than hiding the preview.
            property <length> handle-w: 12px;
            property <length> min-sources: 240px;
            property <length> min-preview: 200px;
            property <length> max-sources: max(self.min-sources, self.width - self.handle-w - self.min-preview);
            property <length> sources-w: clamp(root.sources-width, self.min-sources, self.max-sources);

            // Left pane: one slot per image, scrolling when they don't all fit.
            sources := VScrollArea {
                x: 0;
                y: 0;
                width: split.sources-w;
                height: parent.height;
                content-height: root.rows.length * (root.slot-height + root.slot-gap);
                for row[i] in root.rows: ComposerSlot {
                    y: i * (root.slot-height + root.slot-gap);
                    // Leave the scrollbar's strip free.
                    width: sources.content-width - 10px;
                    height: root.slot-height;
                    slot: row;
                    gain-changed(channel, value) => {
                        root.gain-changed(i, channel, value);
                    }
                }
            }

            // Splitter: drag to trade width between the sources and the preview.
            Rectangle {
                x: split.sources-w;
                y: 0;
                width: split.handle-w;
                height: parent.height;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: 4px;
                    border-radius: 2px;
                    background: splitter-touch.pressed || splitter-touch.has-hover
                        ? AppPalette.handle-active
                        : AppPalette.handle;
                }
                splitter-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        // The self-correcting drag the main window's splitter
                        // uses: pressed-x is fixed for the drag while the
                        // handle follows the cursor, so each event adds only
                        // the cursor's offset from the grab point.
                        root.sources-width = clamp(
                            split.sources-w + (self.mouse-x - self.pressed-x),
                            split.min-sources, split.max-sources);
                    }
                }
            }

            // Right pane: the composed preview.
            Rectangle {
                x: split.sources-w + split.handle-w;
                y: 0;
                width: parent.width - split.sources-w - split.handle-w;
                height: parent.height;
                background: AppPalette.canvas;
                border-radius: 6px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.preview;
                    image-fit: contain;
                }
                Text {
                    visible: root.notice != "";
                    text: root.notice;
                    color: AppPalette.body;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width - 24px;
                }
            }
        }

        HorizontalLayout {
            Rectangle {
                width: 110px;
                            Text {
                                text: "Luminance blend";
                                color: AppPalette.body;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                Tooltip {
                                    TipContent {
                                        text: "0 keeps the colour image's lightness, 1 replaces it with the luminance channel made from the L sliders";
                                    }
                                }
                            }
                        }
                        GainSlider {
                            horizontal-stretch: 1;
                            label: "";
                            // The dialog is rebuilt on every opening, and Rust starts the
                            // mix at 0 each time.
                            initial: 0.0;
                            changed(value) => {
                                root.luminance-changed(value);
                            }
                        }
            spacing: 8px;
            ComboBox {
                model: ["FITS (.fits)", "FITS (.fit)", "TIFF (.tiff)"];
                current-index <=> root.save-format;
                width: 140px;
            }
            // Closes the dialog once a file name is chosen. Only enabled once a
            // preview has been composed: the file is made from the same inputs
            // and sliders.
            Button {
                text: "Save…";
                enabled: root.notice == "" && !root.saving;
                clicked => {
                    root.save();
                }
            }
            Button {
                text: "Close";
                clicked => {
                    root.close();
                }
            }
        }
    }
}

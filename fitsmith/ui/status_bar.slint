import { HorizontalBox, Spinner } from "std-widgets.slint";
import { Separator } from "widgets.slint";
import { AppPalette } from "palette.slint";

// The bottom status bar: a spinner and the global activity on the left, the
// fine-grained pipeline step (only while one is running), and cache memory use
// pinned to the far right. Purely presentational — the window feeds the text.
export component StatusBar inherits HorizontalBox {
    in property <int> total-files;
    in property <int> checked-files;
    in property <int> total-exposure;
    in property <int> checked-exposure;
    in property <bool> busy;
    in property <string> status-text;
    in property <string> stage-text;
    in property <string> memory-text;

    function zeropad(value: int) -> string {
        let s = value.to-string-unlocalized();
        return s.character-count < 2 ? "0" + s : s;
    }

    function time(total-seconds: int) -> string {
        let tminutes = total-seconds / 60;
        let seconds = mod(total-seconds, 60);
        let hours = tminutes / 60;
        let minutes = mod(tminutes, 60);
        return "\{zeropad(hours)}:\{zeropad(minutes)}:\{zeropad(seconds)}";
    }

    padding: 6px;
    spacing: 8px;
    cross-axis-alignment: center;

    if root.total_files > 0:
    HorizontalBox {
        alignment: start;
        horizontal-stretch: 0;
        Text {
            text: "Files: \{root.total-files}";
            overflow: elide;
            vertical-alignment: center;
        }

        if root.checked-files > 0:
        Text {
            text: "(\{root.checked-files})";
            overflow: elide;
            vertical-alignment: center;
        }
        Separator { }

        if root.total-exposure > 0: Text {
            text: "Tᵢₙₜ: \{time(root.total-exposure)}";
            overflow: elide;
            vertical-alignment: center;
        }
        if root.checked-exposure > 0: Text {
            text: "(\{time(root.checked-exposure)})";
            overflow: elide;
            vertical-alignment: center;
        }
        if root.total-exposure > 0: Separator { }
    }

    // A live spinner while a load/render is in flight.
    if root.busy: Spinner {
        width: 14px;
        height: 14px;
        indeterminate: true;
    }
    Text {
        text: root.status-text;
        overflow: elide;
        vertical-alignment: center;
    }
    // Separator + action step, shown only while a pipeline step runs.
    if root.stage-text != "": Separator { }
    if root.stage-text != "": Text {
        text: root.stage-text;
        color: AppPalette.muted;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    // Absorb the slack so memory use sits on the far right.
    Rectangle {
        horizontal-stretch: 1;
    }

    Text {
        text: root.memory-text;
        color: AppPalette.muted;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

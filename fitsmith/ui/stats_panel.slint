import { StatItem, StatRow } from "types.slint";
import { PanelPalette } from "panel_palette.slint";

// A docked panel of image statistics: the numeric pixel summary and the star
// metrics in two label columns on the left, a value histogram (normalized bar
// heights, 0..1) on the right. Shown below the image when "Show stats" is on,
// shrinking the image area to fit. Empty `stats` (an already-debayered RGB cube)
// shows a placeholder and hides the histogram; empty `star-stats` (no detectable
// stars, or that same RGB cube) hides the star column.
export component StatsPanel inherits Rectangle {
    in property <[StatRow]> stats;
    in property <[string]> stat-channels;
    in property <[StatItem]> frame-stats;
    in property <[StatItem]> star-stats;
    in property <[float]> histogram;

    property <bool> has-stats: root.stats.length > 0;
    property <bool> has-stars: root.star-stats.length > 0;
    // A single-channel source has no per-channel letters to print; a
    // debayered RGB source has "R"/"G"/"B" printed once above the columns
    // instead of repeating on every row.
    property <bool> has-channel-headers: root.stat-channels.length > 1;
    property <length> stat-label-width: 100px;
    property <length> stat-value-width: 56px;

    height: 230px;
    background: PanelPalette.background;

    HorizontalLayout {
        padding: 10px;
        spacing: 20px;

        // Numeric pixel summary: a label column plus one right-aligned value
        // column per channel.
        VerticalLayout {
            spacing: 4px;
            alignment: start;
            Text {
                text: root.has-stats ? "Statistics" : "No pixel statistics";
                color: PanelPalette.title;
                font-weight: 700;
            }
            if root.has-channel-headers: HorizontalLayout {
                spacing: 6px;
                Text { width: root.stat-label-width; }
                for c in root.stat-channels: Text {
                    width: root.stat-value-width;
                    text: c;
                    color: PanelPalette.title;
                    font-weight: 700;
                    font-size: 12px;
                    horizontal-alignment: right;
                }
            }
            for s in root.stats: HorizontalLayout {
                spacing: 6px;
                Text {
                    width: root.stat-label-width;
                    text: s.label;
                    color: PanelPalette.muted;
                    font-size: 12px;
                }
                for v in s.values: Text {
                    width: root.stat-value-width;
                    text: v;
                    color: PanelPalette.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                }
            }
            for f in root.frame-stats:
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: f.label;
                    color: PanelPalette.muted;
                    font-size: 12px;
                    width: stat-label-width;
                }
                Text {
                    text: f.value;
                    color: PanelPalette.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                }
            }
        }

        // Star metrics — its own column beside the pixel summary, hidden when
        // the frame has no star metrics to show.
        VerticalLayout {
            width: 160px;
            spacing: 4px;
            alignment: start;
            visible: root.has-stars;
            Text {
                text: "Stars";
                color: PanelPalette.title;
                font-weight: 700;
            }
            for s in root.star-stats: Text {
                text: s.label + ": " + s.value;
                color: PanelPalette.muted;
                font-size: 12px;
            }
        }

        // Histogram: one bottom-anchored bar per bucket. It takes the remaining
        // width, so the columns above narrow it rather than crowding it out.
        Rectangle {
            background: PanelPalette.histogram-bg;
            border-color: PanelPalette.histogram-border;
            border-width: 1px;
            horizontal-stretch: 1;
            visible: root.has-stats;
            HorizontalLayout {
                padding: 4px;
                for h in root.histogram: Rectangle {
                    horizontal-stretch: 1;
                    Rectangle {
                        width: parent.width;
                        height: parent.height * h;
                        y: parent.height - self.height;
                        background: #6fbf73;
                    }
                }
            }
        }
    }
}

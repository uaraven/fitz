import { Button } from "std-widgets.slint";
import { AppPalette } from "palette.slint";

// The Help ▸ About overlay. Fills the whole window with a dimmed scrim (click to
// dismiss) and a centered card. Purely presentational — the parent toggles its
// visibility and feeds the version string; there is no Rust callback beyond the
// close signal.
export component AboutDialog inherits Rectangle {
    in property <string> version;
    callback close();

    // Dim the window behind the card; clicking the scrim dismisses.
    background: AppPalette.scrim;
    scrim := TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        width: 380px;
        height: 260px;
        background: AppPalette.card-bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: AppPalette.card-border;
        // Swallow clicks on the card so they don't reach the scrim and close it.
        TouchArea { }

        VerticalLayout {
            padding: 28px;
            spacing: 10px;
            alignment: center;
            cross-axis-alignment: center;

            Image {
                source: @image-url("../assets/128x128.png");
                width: 72px;
                height: 72px;
            }
            Text {
                text: "FitSmith";
                font-size: 24px;
                font-weight: 700;
                color: AppPalette.title;
                horizontal-alignment: center;
            }
            Text {
                text: "Version " + root.version;
                color: AppPalette.muted;
                horizontal-alignment: center;
            }
            Text {
                text: "©2026 Oles Voronin";
                color: AppPalette.body;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 6px;
                Button {
                    text: "Close";
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}

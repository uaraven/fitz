import { VScrollArea } from "scrolling.slint";
import { FileRow, FrameKind } from "types.slint";
import { AppPalette } from "palette.slint";

// The tooltip surface shared by the file list's (and the compositor's) hover tips: its children are
// stacked in a padded column.
export component TipBox inherits Rectangle {
    background: AppPalette.tooltip-bg;
    border-width: 1px;
    border-color: AppPalette.tooltip-border;
    border-radius: 4px;
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        @children
    }
}

// One line (or wrapped paragraph) of tooltip text.
export component TipText inherits Text {
    wrap: word-wrap;
    font-size: 12px;
    color: AppPalette.tooltip-fg;
}

// A hover area that asks for its tooltip after a short dwell and dismisses it
// as soon as the cursor leaves.
export component TipArea inherits TouchArea {
    callback show-tip();
    callback hide-tip();
    property <bool> pending: false;
    changed has-hover => {
        self.pending = self.has-hover;
        if (!self.has-hover) {
            root.hide-tip();
        }
    }
    Timer {
        interval: 600ms;
        running: root.pending;
        triggered => {
            root.pending = false;
            root.show-tip();
        }
    }
}

// The glyph for a frame kind: a star for a light, a crescent moon for a dark,
// a zero for a bias, an empty (evenly lit) square for a flat, and a
// half-filled disc for a dark flat. Drawn on a 24×24 grid.
component FrameKindIcon inherits Path {
    in property <FrameKind> kind;
    viewbox-width: 24;
    viewbox-height: 24;
    fill-rule: evenodd;
    commands: root.kind == FrameKind.dark
        ? "M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"
        : root.kind == FrameKind.bias
        ? "M12 3.5A5.5 8.5 0 1 1 12 20.5A5.5 8.5 0 1 1 12 3.5ZM12 5.9A3.3 6.1 0 1 0 12 18.1A3.3 6.1 0 1 0 12 5.9Z"
        : root.kind == FrameKind.flat
        ? "M18 4H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H6V6h12v12z"
        : root.kind == FrameKind.dark-flat
        ? "M12 22c5.52 0 10-4.48 10-10S17.52 2 12 2 2 6.48 2 12s4.48 10 10 10zm1-17.93c3.94.49 7 3.86 7 7.93s-3.06 7.44-7 7.93V4.07z"
        : "M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z";
}

// The working-set file list. Rows are click-to-highlight; the highlighted row
// is drawn with an accent background and drives the preview. Each row also
// carries a checkbox for an independent multi-selection, toggled by clicking
// the box or pressing Space on the highlighted row. Highlighting is driven by
// index so blink, clicks and keyboard navigation all share one path. When
// focused (click a row, or on startup) the list handles arrow / page / home-end
// / space keys:
//   Up / Down          move highlight by one
//   Space              toggle the highlighted row's checkbox
//   PageUp / PageDown  move by a page   (macOS: Option+Up/Down)
//   Home / End         jump to ends     (macOS: Cmd+Up/Down — Cmd maps to the
//                                        `control` modifier on macOS)
export component FileList inherits Rectangle {
    in property <[FileRow]> files;
    in property <int> selected-index;
    callback select(int);
    callback select-relative(int);
    callback select-first();
    callback select-last();
    // Toggle a row's checkbox (selection) state — by index into the list.
    callback toggle-check(int);

    property <length> row-height: 30px;
    // Rows that fit in the viewport, for Page Up / Down (at least one).
    property <int> page-size: max(1, floor(self.height / root.row-height));

    // Row and error-state colors that have no shared-palette equivalent, keyed
    // on the active color scheme (same idiom `AppPalette` itself uses): a dark
    // muted red on dark themes, a pale red on light ones.
    property <color> row-hover: AppPalette.dark-theme ? #333333 : #e6e6e6;
    property <color> err-bg: AppPalette.dark-theme ? #4d2020 : #f7d6d6;
    property <color> err-hover: AppPalette.dark-theme ? #612a2a : #f2bcbc;
    property <color> err-text: AppPalette.dark-theme ? white : #601818;

    background: AppPalette.panel-bg;
    forward-focus: fs;

    // Keep the highlighted row on screen: whenever the selection moves — via
    // blink, keyboard navigation or a click on a partially-visible row — nudge
    // the list just enough to reveal it.
    changed selected-index => {
        if (root.selected-index >= 0) {
            list.ensure-visible(root.selected-index * root.row-height, root.row-height);
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // Home / End (macOS: Cmd = the `control` modifier).
            if (event.text == Key.Home || (event.text == Key.UpArrow && event.modifiers.control)) {
                root.select-first();
                return accept;
            }
            if (event.text == Key.End || (event.text == Key.DownArrow && event.modifiers.control)) {
                root.select-last();
                return accept;
            }
            // Page Up / Down (macOS: Option = the `alt` modifier).
            if (event.text == Key.PageUp || (event.text == Key.UpArrow && event.modifiers.alt)) {
                root.select-relative(-root.page-size);
                return accept;
            }
            if (event.text == Key.PageDown || (event.text == Key.DownArrow && event.modifiers.alt)) {
                root.select-relative(root.page-size);
                return accept;
            }
            // Space toggles the highlighted row's checkbox (selection).
            if (event.text == Key.Space) {
                if (root.selected-index >= 0) {
                    root.toggle-check(root.selected-index);
                }
                return accept;
            }
            // Single step through the list.
            if (event.text == Key.UpArrow) {
                root.select-relative(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select-relative(1);
                return accept;
            }
            return reject;
        }

        list := VScrollArea {
            content-height: root.files.length * root.row-height;
            for row[idx] in root.files: rowrect := Rectangle {
                property <bool> is-error: row.error != "";
                property <bool> selected: idx == root.selected-index;
                y: idx * root.row-height;
                width: list.content-width;
                height: root.row-height;
                background: self.selected
                    ? AppPalette.accent
                    : (self.is-error
                        ? (touch.has-hover ? root.err-hover : root.err-bg)
                        : (touch.has-hover ? root.row-hover : transparent));
                // The row's own hover/click area. The row's content sits inside
                // it so the row stays hover-highlighted while the cursor is over
                // the name or the badge, whose own areas show their tooltips.
                touch := TouchArea {
                    clicked => {
                        fs.focus();
                        root.select(idx);
                    }
                    // Checkbox, frame-kind icon and name on the left, an
                    // optional status badge on the right — one line.
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        // A small checkbox reflecting the row's selection state.
                        // Its own TouchArea takes the click, so ticking a box
                        // does not change which row is highlighted.
                        VerticalLayout {
                            alignment: center;
                            checkbox := Rectangle {
                                width: 16px;
                                height: 16px;
                                border-width: 1px;
                                border-radius: 3px;
                                border-color: row.checked ? AppPalette.accent : #8a8a8a;
                                background: row.checked ? AppPalette.accent : transparent;
                                Text {
                                    text: "✓";
                                    visible: row.checked;
                                    font-size: 12px;
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.toggle-check(idx);
                                    }
                                }
                            }
                        }
                        // The frame kind's icon, with its name as a tooltip.
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                accessible-role: image;
                                accessible-label: row.kind-tip;
                                FrameKindIcon {
                                    kind: row.kind;
                                    fill: rowrect.selected ? AppPalette.on-accent : AppPalette.muted;
                                }
                                TipArea {
                                    clicked => {
                                        fs.focus();
                                        root.select(idx);
                                    }
                                    show-tip => {
                                        kind-tip.show();
                                    }
                                    hide-tip => {
                                        kind-tip.close();
                                    }
                                }
                                kind-tip := PopupWindow {
                                    x: 0;
                                    y: (root.row-height + 16px) / 2 - 2px;
                                    TipBox {
                                        TipText {
                                            text: row.kind-tip;
                                            wrap: no-wrap;
                                        }
                                    }
                                }
                            }
                        }
                        // The path relative to the working set's common folder,
                        // elided when the list is too narrow for it. Hovering the
                        // name itself (not the empty space after it) shows the
                        // full path.
                        name-text := Text {
                            text: row.name;
                            // White on the selected row's blue background in
                            // either theme; dark text on the pale-red error
                            // background used by light themes; the theme's row
                            // color otherwise.
                            color: rowrect.selected
                                ? white
                                : (rowrect.is-error ? root.err-text : AppPalette.panel-value);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            TipArea {
                                x: 0;
                                width: min(name-text.width, name-text.preferred-width);
                                clicked => {
                                    fs.focus();
                                    root.select(idx);
                                }
                                show-tip => {
                                    path-tip.show();
                                }
                                hide-tip => {
                                    path-tip.close();
                                }
                            }
                        }
                        // A compressed (.fz) file gets a small "compress" glyph —
                        // two chevrons pointing inward — instead of a word; any
                        // other status ("error") is still spelled out.
                        if row.status == "compressed": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                accessible-role: image;
                                accessible-label: "Compressed FITS file";
                                Path {
                                    commands: "M7.4,22L6,20.6l6-6l6,6L16.6,22L12,17.4L7.4,22ZM12,9.4l-6-6L7.4,2L12,6.6L16.6,2L18,3.4l-6,6Z";
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    fill: rowrect.selected ? AppPalette.on-accent : AppPalette.muted;
                                }
                                TipArea {
                                    clicked => {
                                        fs.focus();
                                        root.select(idx);
                                    }
                                    show-tip => {
                                        badge-tip.show();
                                    }
                                    hide-tip => {
                                        badge-tip.close();
                                    }
                                }
                                // Right-aligned under the glyph, which sits at the
                                // row's right edge.
                                badge-tip := PopupWindow {
                                    x: 16px - self.width;
                                    y: (root.row-height + 16px) / 2 - 2px;
                                    TipBox {
                                        TipText {
                                            text: "Compressed FITS file";
                                            wrap: no-wrap;
                                        }
                                    }
                                }
                            }
                        }
                        if row.status != "compressed": Text {
                            text: row.status;
                            visible: row.status != "";
                            font-size: 11px;
                            color: row.status == "error" ? AppPalette.danger : AppPalette.muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Tooltip over the name carrying the full path and, for a row
                // that failed to load, the error. A PopupWindow renders in a
                // top-level overlay, so it isn't clipped by the (narrow) list.
                path-tip := PopupWindow {
                    x: 12px;
                    y: root.row-height - 2px;
                    TipBox {
                        // Snug around a short path, wrapping a long one; an
                        // error message gets room to wrap legibly.
                        width: min(420px, max(path-text.preferred-width + 16px, rowrect.is-error ? 280px : 0px));
                        path-text := TipText {
                            text: row.path;
                        }
                        if rowrect.is-error: TipText {
                            text: row.error;
                        }
                    }
                }
            }
        }
    }
}

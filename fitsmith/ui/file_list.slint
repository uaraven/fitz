import { VScrollArea } from "scrolling.slint";
import { FileRow } from "types.slint";
import { AppPalette } from "palette.slint";

// The working-set file list. Rows are click-to-highlight; the highlighted row
// is drawn with an accent background and drives the preview. Each row also
// carries a checkbox for an independent multi-selection, toggled by clicking
// the box or pressing Space on the highlighted row. Highlighting is driven by
// index so blink, clicks and keyboard navigation all share one path. When
// focused (click a row, or on startup) the list handles arrow / page / home-end
// / space keys:
//   Up / Down          move highlight by one
//   Space              toggle the highlighted row's checkbox
//   PageUp / PageDown  move by a page   (macOS: Option+Up/Down)
//   Home / End         jump to ends     (macOS: Cmd+Up/Down — Cmd maps to the
//                                        `control` modifier on macOS)
export component FileList inherits Rectangle {
    in property <[FileRow]> files;
    in property <int> selected-index;
    callback select(int);
    callback select-relative(int);
    callback select-first();
    callback select-last();
    // Toggle a row's checkbox (selection) state — by index into the list.
    callback toggle-check(int);

    property <length> row-height: 30px;
    // Rows that fit in the viewport, for Page Up / Down (at least one).
    property <int> page-size: max(1, floor(self.height / root.row-height));

    // Row and error-state colors that have no shared-palette equivalent, keyed
    // on the active color scheme (same idiom `AppPalette` itself uses): a dark
    // muted red on dark themes, a pale red on light ones.
    property <color> row-hover: AppPalette.dark-theme ? #333333 : #e6e6e6;
    property <color> err-bg: AppPalette.dark-theme ? #4d2020 : #f7d6d6;
    property <color> err-hover: AppPalette.dark-theme ? #612a2a : #f2bcbc;
    property <color> err-text: AppPalette.dark-theme ? white : #601818;

    background: AppPalette.panel-bg;
    forward-focus: fs;

    // Keep the highlighted row on screen: whenever the selection moves — via
    // blink, keyboard navigation or a click on a partially-visible row — nudge
    // the list just enough to reveal it.
    changed selected-index => {
        if (root.selected-index >= 0) {
            list.ensure-visible(root.selected-index * root.row-height, root.row-height);
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // Home / End (macOS: Cmd = the `control` modifier).
            if (event.text == Key.Home || (event.text == Key.UpArrow && event.modifiers.control)) {
                root.select-first();
                return accept;
            }
            if (event.text == Key.End || (event.text == Key.DownArrow && event.modifiers.control)) {
                root.select-last();
                return accept;
            }
            // Page Up / Down (macOS: Option = the `alt` modifier).
            if (event.text == Key.PageUp || (event.text == Key.UpArrow && event.modifiers.alt)) {
                root.select-relative(-root.page-size);
                return accept;
            }
            if (event.text == Key.PageDown || (event.text == Key.DownArrow && event.modifiers.alt)) {
                root.select-relative(root.page-size);
                return accept;
            }
            // Space toggles the highlighted row's checkbox (selection).
            if (event.text == Key.Space) {
                if (root.selected-index >= 0) {
                    root.toggle-check(root.selected-index);
                }
                return accept;
            }
            // Single step through the list.
            if (event.text == Key.UpArrow) {
                root.select-relative(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select-relative(1);
                return accept;
            }
            return reject;
        }

        list := VScrollArea {
            content-height: root.files.length * root.row-height;
            for row[idx] in root.files: rowrect := Rectangle {
                property <bool> is-error: row.error != "";
                property <bool> selected: idx == root.selected-index;
                y: idx * root.row-height;
                width: list.content-width;
                height: root.row-height;
                background: self.selected
                    ? AppPalette.accent
                    : (self.is-error
                        ? (touch.has-hover ? root.err-hover : root.err-bg)
                        : (touch.has-hover ? root.row-hover : transparent));
                touch := TouchArea {
                    clicked => {
                        fs.focus();
                        root.select(idx);
                    }
                    // After a short hover, show the full path (and any load
                    // error) as a tooltip; hide it as soon as the cursor leaves.
                    changed has-hover => {
                        rowrect.hover-pending = self.has-hover;
                        if (!self.has-hover) {
                            tooltip.close();
                        }
                    }
                }
                property <bool> hover-pending: false;
                Timer {
                    interval: 600ms;
                    running: rowrect.hover-pending;
                    triggered => {
                        rowrect.hover-pending = false;
                        tooltip.show();
                    }
                }
                // Checkbox, name on the left, an optional status badge on the
                // right — one line.
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    // A small checkbox reflecting the row's selection state. Its
                    // own TouchArea sits above the row's, so ticking a box does
                    // not change which row is highlighted.
                    VerticalLayout {
                        alignment: center;
                        checkbox := Rectangle {
                            width: 16px;
                            height: 16px;
                            border-width: 1px;
                            border-radius: 3px;
                            border-color: row.checked ? AppPalette.accent : #8a8a8a;
                            background: row.checked ? AppPalette.accent : transparent;
                            Text {
                                text: "✓";
                                visible: row.checked;
                                font-size: 12px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.toggle-check(idx);
                                }
                            }
                        }
                    }
                    // The path relative to the working set's common folder,
                    // elided when the list is too narrow for it.
                    Text {
                        text: row.name;
                        // White on the selected row's blue background in either
                        // theme; dark text on the pale-red error background used
                        // by light themes; the theme's row color otherwise.
                        color: rowrect.selected
                            ? white
                            : (rowrect.is-error ? root.err-text : AppPalette.panel-value);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    // A compressed (.fz) file gets a small "vise" glyph — two
                    // jaws squeezing inward — instead of a word; any other
                    // status ("error") is still spelled out.
                    if row.status == "compressed": VerticalLayout {
                        alignment: center;
                        Path {
                            width: 16px;
                            height: 16px;
                            commands: "M 1 3 L 1 13 M 15 3 L 15 13 M 2 8 L 6 8 M 4 6 L 6 8 L 4 10 M 14 8 L 10 8 M 12 6 L 10 8 L 12 10";
                            viewbox-width: 16;
                            viewbox-height: 16;
                            fill: transparent;
                            stroke: rowrect.selected ? AppPalette.on-accent : AppPalette.muted;
                            stroke-width: 1.5px;
                            accessible-role: image;
                            accessible-label: "Compressed";
                        }
                    }
                    if row.status != "compressed": Text {
                        text: row.status;
                        visible: row.status != "";
                        font-size: 11px;
                        color: row.status == "error" ? AppPalette.danger : AppPalette.muted;
                        vertical-alignment: center;
                    }
                }

                // Hover tooltip carrying the full path and, for a row that
                // failed to load, the error. A PopupWindow renders in a
                // top-level overlay, so it isn't clipped by the (narrow) list.
                tooltip := PopupWindow {
                    x: 12px;
                    y: root.row-height - 2px;
                    Rectangle {
                        // Snug around a short path, wrapping a long one; an
                        // error message gets room to wrap legibly.
                        width: min(420px, max(path-text.preferred-width + 16px, rowrect.is-error ? 280px : 0px));
                        background: AppPalette.tooltip-bg;
                        border-width: 1px;
                        border-color: AppPalette.tooltip-border;
                        border-radius: 4px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            path-text := Text {
                                text: row.path;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: AppPalette.tooltip-fg;
                            }
                            if rowrect.is-error: Text {
                                text: row.error;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: AppPalette.tooltip-fg;
                            }
                        }
                    }
                }
            }
        }
    }
}

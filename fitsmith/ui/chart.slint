import { Palette } from "std-widgets.slint";
import { ChartPoint, ChartTick } from "types.slint";

// One channel's point marks and hover tooltips, positioned within its
// parent's `width`/`height` (the plot area). Factored out so the chart can
// instantiate it once per channel (1 for a star metric or a single-channel
// pixel source, 3 for a per-channel one) without repeating the markup —
// unlike the line itself, Slint has no trouble repeating a plain component.
component ChannelMarks inherits Rectangle {
    in property <[ChartPoint]> points;
    in property <color> mark-color;
    in property <color> hover-color;
    in property <color> tip-bg;
    in property <color> tip-fg;
    in property <color> tip-border;

    background: transparent;

    for point in root.points: mark := Rectangle {
        x: point.x * root.width - self.width / 2;
        y: point.y * root.height - self.height / 2;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: touch.has-hover ? root.hover-color : root.mark-color;
        touch := TouchArea { }

        if touch.has-hover: Rectangle {
            // Above the mark, or below when too close to the top edge.
            x: (mark.width - tip-layout.preferred-width) / 2;
            y: point.y * root.height < 56px
                ? mark.height + 4px
                : -tip-layout.preferred-height - 4px;
            width: tip-layout.preferred-width;
            height: tip-layout.preferred-height;
            background: root.tip-bg;
            border-width: 1px;
            border-color: root.tip-border;
            border-radius: 4px;
            tip-layout := VerticalLayout {
                padding: 7px;
                spacing: 2px;
                Text {
                    text: point.time-label;
                    color: root.tip-fg;
                    font-size: 11px;
                    font-weight: 700;
                }
                Text {
                    text: point.value-label;
                    color: root.tip-fg;
                    font-size: 11px;
                }
            }
        }
    }
}

// A time-series line chart with point marks: the plot area of the analytics
// dialog (not a dialog itself). Purely presentational — the controller feeds
// screen-normalized 0..1 points per channel and the matching SVG line-command
// strings (Slint can't repeat Path elements with `for`, slint#754, hence three
// fixed R/G/B slots rather than a list), plus pre-formatted tick labels. A
// single-channel series (a star metric, or a mono/CFA pixel source) uses only
// the R slot and draws in a neutral blue; a per-channel pixel metric on an
// already-debayered RGB source fills all three and draws in red/green/blue.
// Y always fits the widget; X stretches by `zoom` inside a horizontal
// Flickable, so zoom > 1 scrolls sideways and session gaps (meridian flip,
// clouds) stay visible as real gaps. Hovering a mark shows a time/value
// tooltip. All colors derive from the active color scheme, so the chart is
// legible on light and dark themes alike.
export component AnalyticsChart inherits Rectangle {
    // Channel R — the sole channel when `label-r` is empty.
    in property <[ChartPoint]> points-r;
    in property <string> line-r;
    in property <string> label-r;
    // Channel G — empty (`label-g` "") unless the series is per-channel.
    in property <[ChartPoint]> points-g;
    in property <string> line-g;
    in property <string> label-g;
    // Channel B.
    in property <[ChartPoint]> points-b;
    in property <string> line-b;
    in property <string> label-b;
    in property <[ChartTick]> x-ticks;
    in property <[ChartTick]> y-ticks;
    // 1.0 = fit the width; up to 4.0 = 4x wider, scrolled horizontally.
    in property <float> zoom: 1.0;
    // Y-axis title (the plotted metric's name).
    in property <string> metric-label;

    // Theme palette, keyed on the active color scheme (same pattern as the
    // file list's error/tooltip colors).
    property <bool> dark-theme: Palette.color-scheme == ColorScheme.dark;
    property <color> plot-bg: root.dark-theme ? #1e1e1e : #fdfdfd;
    property <color> axis-color: root.dark-theme ? #666666 : #999999;
    property <color> grid-color: root.dark-theme ? #333333 : #e4e4e4;
    property <bool> per-channel: root.label-g != "" || root.label-b != "";
    property <color> single-color: root.dark-theme ? #4da3e8 : #0a5ea8;
    property <color> color-r: root.per-channel ? #e05252 : root.single-color;
    property <color> color-g: #2ea043;
    property <color> color-b: #3b82f6;
    property <color> mark-hover: root.dark-theme ? #ffffff : #063d6e;
    property <color> label-color: root.dark-theme ? #b0b0b0 : #555555;
    property <color> tip-bg: root.dark-theme ? #2b2b2b : #fbfbfb;
    property <color> tip-fg: root.dark-theme ? #e0e0e0 : #202020;
    property <color> tip-border: root.dark-theme ? #555555 : #cccccc;

    // Fixed gutters for the axis labels; the plot fills the rest.
    property <length> y-axis-w: 64px;
    // Tall enough for both X label rows: the local date above the time.
    property <length> x-axis-h: 34px;
    property <length> title-h: 18px;
    property <length> area-h: root.height - root.x-axis-h - root.title-h;
    property <length> viewport-w: root.width - root.y-axis-w;
    // The scrollable plot width: fit at zoom 1, wider beyond.
    property <length> content-w: root.viewport-w * root.zoom;

    preferred-height: 300px;

    // Y-axis title, top-left above the tick labels.
    Text {
        x: 0;
        y: 0;
        height: root.title-h;
        text: root.metric-label;
        color: root.label-color;
        font-size: 11px;
        font-weight: 700;
    }

    // Y tick labels, right-aligned against the plot's left edge. Fixed while
    // the plot scrolls (Y always fits, only X zooms).
    for tick in root.y-ticks: Text {
        x: 0;
        y: root.title-h + tick.pos * root.area-h - self.height / 2;
        width: root.y-axis-w - 8px;
        horizontal-alignment: right;
        text: tick.label;
        color: root.label-color;
        font-size: 11px;
    }

    flick := Flickable {
        x: root.y-axis-w;
        y: root.title-h;
        width: root.viewport-w;
        height: root.area-h + root.x-axis-h;
        viewport-width: root.content-w;
        viewport-height: self.height;

        // Plot background and frame (the axes).
        Rectangle {
            x: 0;
            y: 0;
            width: root.content-w;
            height: root.area-h;
            background: root.plot-bg;
            border-width: 1px;
            border-color: root.axis-color;
        }

        // Gridlines: horizontal per Y tick, vertical per X tick. They live in
        // the scrolled content so vertical lines track their timestamps.
        for tick in root.y-ticks: Rectangle {
            x: 0;
            y: tick.pos * root.area-h;
            width: root.content-w;
            height: 1px;
            background: root.grid-color;
        }
        for tick in root.x-ticks: Rectangle {
            x: tick.pos * root.content-w;
            y: 0;
            width: 1px;
            height: root.area-h;
            background: root.grid-color;
        }

        // X tick labels, below the plot; they scroll with their gridlines.
        // Clamped inside the content so the first/last labels aren't half cut
        // off at the plot edges. Each tick is two rows — the local date above
        // the time — laid out as a unit so the rows stay centered on each
        // other. A tick without a date still lays out its empty row, keeping
        // every time on the lower one.
        for tick in root.x-ticks: VerticalLayout {
            x: clamp(tick.pos * root.content-w - self.width / 2, 0px, root.content-w - self.width);
            y: root.area-h + 3px;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: 1px;
            Text {
                min-height: 13px;
                text: tick.date-label;
                color: root.label-color;
                font-size: 11px;
                horizontal-alignment: center;
            }
            Text {
                text: tick.label;
                color: root.label-color;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }

        // The series lines. Each channel's 0..1 viewbox with `fill` stretches
        // its normalized commands to the (zoomed) plot size; stroke width
        // stays in logical pixels. The R slot is always drawn; G/B only exist
        // for a per-channel (3-channel) series.
        Path {
            x: 0;
            y: 0;
            width: root.content-w;
            height: root.area-h;
            commands: root.line-r;
            viewbox-width: 1.0;
            viewbox-height: 1.0;
            fit: fill;
            stroke: root.color-r;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        if root.label-g != "": Path {
            x: 0;
            y: 0;
            width: root.content-w;
            height: root.area-h;
            commands: root.line-g;
            viewbox-width: 1.0;
            viewbox-height: 1.0;
            fit: fill;
            stroke: root.color-g;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        if root.label-b != "": Path {
            x: 0;
            y: 0;
            width: root.content-w;
            height: root.area-h;
            commands: root.line-b;
            viewbox-width: 1.0;
            viewbox-height: 1.0;
            fit: fill;
            stroke: root.color-b;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        // Point marks + hover tooltips, one instance per channel slot.
        ChannelMarks {
            x: 0;
            y: 0;
            width: root.content-w;
            height: root.area-h;
            points: root.points-r;
            mark-color: root.color-r;
            hover-color: root.mark-hover;
            tip-bg: root.tip-bg;
            tip-fg: root.tip-fg;
            tip-border: root.tip-border;
        }
        if root.label-g != "": ChannelMarks {
            x: 0;
            y: 0;
            width: root.content-w;
            height: root.area-h;
            points: root.points-g;
            mark-color: root.color-g;
            hover-color: root.mark-hover;
            tip-bg: root.tip-bg;
            tip-fg: root.tip-fg;
            tip-border: root.tip-border;
        }
        if root.label-b != "": ChannelMarks {
            x: 0;
            y: 0;
            width: root.content-w;
            height: root.area-h;
            points: root.points-b;
            mark-color: root.color-b;
            hover-color: root.mark-hover;
            tip-bg: root.tip-bg;
            tip-fg: root.tip-fg;
            tip-border: root.tip-border;
        }
    }

    if root.points-r.length == 0 && root.points-g.length == 0 && root.points-b.length == 0: Text {
        x: root.y-axis-w + (root.viewport-w - self.width) / 2;
        y: root.title-h + (root.area-h - self.height) / 2;
        text: "No data to plot";
        color: root.label-color;
    }
}
